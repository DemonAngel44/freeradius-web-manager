# FreeRADIUS Web Manager Configuration

# Flask secret key (generate a random string for production)
SECRET_KEY=your-secret-key-here

# RADIUS server settings
RADIUS_SERVER=localhost
RADIUS_PORT=1812
RADIUS_SECRET=your-radius-secret

# Path to FreeRADIUS users file (inside container)
USERS_FILE=/data/authorize

# Username prefix for admin access (optional - leave empty for any authenticated user)
# Example: ADMIN_GROUP_PREFIX=admin- would only allow users starting with "admin-"
ADMIN_GROUP_PREFIX=

# Docker container name for FreeRADIUS (for reload command)
FREERADIUS_CONTAINER=freeradius

# Path to setup complete marker file (inside container)
SETUP_COMPLETE_FILE=/data/.setup_complete
